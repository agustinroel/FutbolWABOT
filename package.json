{
  "name": "futbol-montemar-whatsapp-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bot local de WhatsApp para organizar partidos semanales en Montemar.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:dashboard-api": "tsx watch src/dashboard-api.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:dashboard-api": "node dist/dashboard-api.js",
    "test": "node --import tsx --test tests/balancer.test.ts tests/queue.test.ts tests/messageContext.test.ts tests/matches.test.ts tests/whatsappFormat.test.ts tests/dashboard.test.ts",
    "lint": "eslint .",
    "build:all": "npm run build && npm --prefix apps/web run build",
    "dev:web": "npm --prefix apps/web run dev -- --hostname 127.0.0.1",
    "build:web": "npm --prefix apps/web run build",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "start:web": "npm --prefix apps/web run start -- --hostname 127.0.0.1",
    "format": "prettier --write .",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:push": "npm run db:migrate"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "node-cron": "^4.2.1",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "1.34.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode-terminal": "^0.12.2",
    "eslint": "^9.29.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "puppeteer@24.38.0": true
  }
}
