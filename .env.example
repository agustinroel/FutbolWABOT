# Identificador del grupo de WhatsApp, por ejemplo 120363012345678901@g.us
MONTEMAR_GROUP_ID=
# Números/JID de administradores separados por comas, por ejemplo 34600112233
ADMIN_PHONE_NUMBERS=
# Zona horaria usada por las convocatorias (IANA)
TIMEZONE=Europe/Madrid
# SQLite local; las carpetas se crean automáticamente
DATABASE_PATH=./data/montemar.sqlite
# Opcional: ruta a Chrome/Chromium instalado, útil si Puppeteer no pudo descargar Chromium.
PUPPETEER_EXECUTABLE_PATH=
# Cupo confirmado por partido: normalmente 10 o 14
MATCH_CAPACITY=14
MATCH_TIME=20:00
PITCH_LOCATION=Cancha Montemar, Alicante
# Opcional: importe fijo en euros por jugador. Si se deja vacío se usa el coste total dividido por el cupo.
FEE_PER_PLAYER=
PITCH_COST=
# API de solo lectura para el dashboard. No expongas este puerto a Internet sin HTTPS.
# DASHBOARD_API_ENABLED=true inicia el API junto con el bot; ponlo en false si ejecutas src/dashboard-api.ts aparte.
DASHBOARD_API_ENABLED=true
DASHBOARD_API_HOST=127.0.0.1
DASHBOARD_API_PORT=8787
DASHBOARD_API_TOKEN=
# Dominio DNS que apuntará al VPS; se utiliza con el perfil Docker "public-api" y Caddy.
DASHBOARD_API_DOMAIN=
